{
  "swagger": "2.0",
  "info": {
    "title": "TienTonAudio REST API",
    "description": "API Platform hoàn chỉnh cho ứng dụng nghe truyện audio và đọc tiểu thuyết Tiên Hiệp TienTonAudio.",
    "version": "1.0.0",
    "contact": {
      "name": "IREAKING Support",
      "url": "https://github.com/IREAKING/TienTonAudio",
      "email": "support@tientonaudio.com"
    }
  },
  "host": "localhost:8080",
  "basePath": "/api/v1",
  "schemes": [
    "http",
    "https"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Nhập token dạng: Bearer <your_jwt_access_token>"
    }
  },
  "tags": [
    { "name": "Auth", "description": "Xác thực, Đăng ký, Đăng nhập, Quên mật khẩu, 2FA OTP" },
    { "name": "Users", "description": "Hồ sơ người dùng, Lịch sử nghe, Đổi mật khẩu, Yêu thích" },
    { "name": "Stories", "description": "Danh sách truyện, Top Views, Tìm kiếm & Lọc thể loại" },
    { "name": "Chapters", "description": "Tập truyện, Phát Audio có chữ ký (Signed Stream URL), Tiến độ nghe" },
    { "name": "Comments", "description": "Bình luận lồng nhau đa cấp & Thả biểu cảm cảm xúc" },
    { "name": "Playlists", "description": "Danh sách phát tùy chỉnh của người dùng" },
    { "name": "Notifications", "description": "Thông báo tương tác, tập mới, hệ thống" },
    { "name": "Authors & Narrators", "description": "Theo dõi Tác giả và MC Giọng đọc" },
    { "name": "Reports", "description": "Báo cáo lỗi âm thanh hoặc vi phạm" },
    { "name": "Payments", "description": "Gói hội viên VIP & Nâng cấp tài khoản" },
    { "name": "AI Assistant", "description": "Trợ lý AI Đạo Hữu hỏi đáp cốt truyện & Tóm tắt cảnh giới" },
    { "name": "Admin", "description": "Thống kê doanh thu, Quản trị người dùng, Tác giả, MC và Báo cáo" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Đăng ký tài khoản mới",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["username", "email", "password"],
            "properties": {
              "username": { "type": "string", "example": "daohuu123" },
              "email": { "type": "string", "example": "daohuu@gmail.com" },
              "password": { "type": "string", "example": "MatKhau123@" }
            }
          }
        }],
        "responses": {
          "201": { "description": "Đăng ký thành công, gửi mã xác thực email" },
          "400": { "description": "Dữ liệu không hợp lệ hoặc email đã tồn tại" }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Xác thực email bằng mã OTP / Token",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["email", "token"],
            "properties": {
              "email": { "type": "string", "example": "daohuu@gmail.com" },
              "token": { "type": "string", "example": "123456" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Xác thực email thành công" },
          "400": { "description": "Token không hợp lệ hoặc đã hết hạn" }
        }
      }
    },
    "/auth/resend-verification": {
      "post": {
        "tags": ["Auth"],
        "summary": "Gửi lại mã xác thực email",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["email"],
            "properties": {
              "email": { "type": "string", "example": "daohuu@gmail.com" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Đã gửi lại email xác thực" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Đăng nhập",
        "description": "Nếu tài khoản đã bật 2FA, hệ thống trả về mfa_required: true kèm mfa_token để xác minh bước 2.",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["email", "password"],
            "properties": {
              "email": { "type": "string", "example": "daohuu@gmail.com" },
              "password": { "type": "string", "example": "MatKhau123@" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Đăng nhập thành công, trả về Access Token & Refresh Token" },
          "401": { "description": "Sai email hoặc mật khẩu" }
        }
      }
    },
    "/auth/2fa/verify": {
      "post": {
        "tags": ["Auth"],
        "summary": "Xác minh đăng nhập bước 2 (2FA TOTP hoặc Backup Code)",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["mfa_token", "code"],
            "properties": {
              "mfa_token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsIn..." },
              "code": { "type": "string", "example": "123456" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Xác thực 2FA thành công, cấp Access Token" },
          "401": { "description": "Mã OTP không hợp lệ" }
        }
      }
    },
    "/auth/2fa/setup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Tạo Secret Key và QR Code để cài đặt Google Authenticator",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Trả về secret và otpauth_url để quét mã QR" }
        }
      }
    },
    "/auth/2fa/enable": {
      "post": {
        "tags": ["Auth"],
        "summary": "Kích hoạt 2FA sau khi quét mã QR",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["secret", "code"],
            "properties": {
              "secret": { "type": "string" },
              "code": { "type": "string", "example": "123456" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Bật 2FA thành công, trả về 8 mã dự phòng (Backup Codes)" }
        }
      }
    },
    "/auth/2fa/disable": {
      "post": {
        "tags": ["Auth"],
        "summary": "Tắt xác thực 2FA",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": { "type": "string", "example": "123456" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Đã tắt 2FA thành công" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Yêu cầu khôi phục mật khẩu qua Email",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["email"],
            "properties": {
              "email": { "type": "string", "example": "daohuu@gmail.com" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Đã gửi email khôi phục mật khẩu nếu tài khoản tồn tại" }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Đặt mật khẩu mới bằng Token khôi phục",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["token", "new_password"],
            "properties": {
              "token": { "type": "string" },
              "new_password": { "type": "string", "example": "MatKhauMoi123@" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Mật khẩu đã được thay đổi thành công" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Xoay vòng Refresh Token lấy Access Token mới",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["refresh_token"],
            "properties": {
              "refresh_token": { "type": "string" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Cấp Access Token mới" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Đăng xuất tài khoản và thu hồi Refresh Token",
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["refresh_token"],
            "properties": {
              "refresh_token": { "type": "string" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Đăng xuất thành công" }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Lấy thông tin tài khoản hiện tại",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Thông tin người dùng, vai trò, trạng thái 2FA" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Cập nhật hồ sơ (Tên hiển thị, Ảnh đại diện)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "username": { "type": "string" },
              "avatar_url": { "type": "string" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Cập nhật hồ sơ thành công" }
        }
      }
    },
    "/cultivation/realms": {
      "get": {
        "tags": ["Cultivation"],
        "summary": "Lấy danh sách 17 Cảnh Giới Tu Tiên chính thống (Luyện Khí -> Tiên Đế)",
        "responses": {
          "200": { "description": "Danh sách 17 cảnh giới, mức exp tối thiểu/tối đa, mô tả và màu sắc" }
        }
      }
    },
    "/users/cultivation": {
      "get": {
        "tags": ["Cultivation"],
        "summary": "Lấy thông tin cảnh giới tu vi, điểm exp, % đột phá và hệ số tu luyện của Đạo Hữu",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Thông tin chi tiết cảnh giới tu tiên của người dùng hiện tại" }
        }
      }
    },
    "/users/password": {
      "put": {
        "tags": ["Users"],
        "summary": "Đổi mật khẩu tài khoản",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["old_password", "new_password"],
            "properties": {
              "old_password": { "type": "string" },
              "new_password": { "type": "string" }
            }
          }
        }],
        "responses": {
          "200": { "description": "Đổi mật khẩu thành công" }
        }
      }
    },
    "/users/history": {
      "get": {
        "tags": ["Users"],
        "summary": "Lấy lịch sử nghe audio của người dùng",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 }
        ],
        "responses": {
          "200": { "description": "Danh sách lịch sử nghe kèm thời gian dừng" }
        }
      }
    },
    "/users/favorites": {
      "get": {
        "tags": ["Users"],
        "summary": "Lấy danh sách truyện yêu thích trong Tủ Truyện",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Danh sách truyện đã đánh dấu yêu thích" }
        }
      }
    },
    "/users/following-authors": {
      "get": {
        "tags": ["Users"],
        "summary": "Danh sách các tác giả đang theo dõi",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Danh sách tác giả" }
        }
      }
    },
    "/users/following-narrators": {
      "get": {
        "tags": ["Users"],
        "summary": "Danh sách các MC Giọng đọc đang theo dõi",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Danh sách narrator" }
        }
      }
    },
    "/stories": {
      "get": {
        "tags": ["Stories"],
        "summary": "Lấy danh sách truyện mới cập nhật (phân trang)",
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 }
        ],
        "responses": {
          "200": { "description": "Danh sách truyện mới nhất" }
        }
      },
      "post": {
        "tags": ["Stories"],
        "summary": "Tạo mới tác phẩm truyện",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "in": "body",
          "name": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["title", "slug"],
            "properties": {
              "title": { "type": "string", "example": "Võ Luyện Đỉnh Phong" },
              "slug": { "type": "string", "example": "vo-luyen-dinh-phong" },
              "description": { "type": "string" },
              "author_id": { "type": "string" },
              "cover_image_url": { "type": "string" },
              "category_ids": { "type": "array", "items": { "type": "integer" } }
            }
          }
        }],
        "responses": {
          "201": { "description": "Tạo truyện thành công" }
        }
      }
    },
    "/stories/top-views": {
      "get": {
        "tags": ["Stories"],
        "summary": "Bảng Vàng Tiên Vương (Top truyện nghe nhiều nhất)",
        "parameters": [
          { "name": "limit", "in": "query", "type": "integer", "default": 10 }
        ],
        "responses": {
          "200": { "description": "Top truyện nhiều lượt nghe nhất" }
        }
      }
    },
    "/stories/search": {
      "get": {
        "tags": ["Stories"],
        "summary": "Tìm kiếm nhanh truyện theo từ khóa",
        "parameters": [
          { "name": "q", "in": "query", "type": "string", "required": true, "example": "Phàm nhân" },
          { "name": "limit", "in": "query", "type": "integer", "default": 10 }
        ],
        "responses": {
          "200": { "description": "Kết quả tìm kiếm" }
        }
      }
    },
    "/stories/filter": {
      "get": {
        "tags": ["Stories"],
        "summary": "Bộ lọc nâng cao (Thể loại, Trạng thái, Sắp xếp)",
        "parameters": [
          { "name": "q", "in": "query", "type": "string" },
          { "name": "category_id", "in": "query", "type": "integer" },
          { "name": "status", "in": "query", "type": "string", "enum": ["ongoing", "completed"] },
          { "name": "sort_by", "in": "query", "type": "string", "enum": ["views", "latest", "rating"], "default": "latest" },
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 }
        ],
        "responses": {
          "200": { "description": "Danh sách truyện thỏa mãn điều kiện lọc" }
        }
      }
    },
    "/stories/categories": {
      "get": {
        "tags": ["Stories"],
        "summary": "Lấy danh mục tất cả thể loại truyện",
        "responses": {
          "200": { "description": "Danh mục thể loại (Tiên Hiệp, Kiếm Hiệp, Huyền Huyễn...)" }
        }
      }
    },
    "/stories/{slug}": {
      "get": {
        "tags": ["Stories"],
        "summary": "Lấy chi tiết truyện theo Slug hoặc ID",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "type": "string", "example": "vo-luyen-dinh-phong" }
        ],
        "responses": {
          "200": { "description": "Chi tiết tác phẩm, tác giả, đánh giá, tổng số chương" },
          "404": { "description": "Truyện không tồn tại" }
        }
      }
    },
    "/stories/{id}/related": {
      "get": {
        "tags": ["Stories"],
        "summary": "Lấy danh sách các tác phẩm tương tự",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          { "name": "limit", "in": "query", "type": "integer", "default": 6 }
        ],
        "responses": {
          "200": { "description": "Danh sách truyện tương tự" }
        }
      }
    },
    "/stories/{storyId}/chapters": {
      "get": {
        "tags": ["Stories"],
        "summary": "Lấy danh sách tất cả các tập của một bộ truyện",
        "parameters": [
          { "name": "storyId", "in": "path", "required": true, "type": "string" },
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 50 }
        ],
        "responses": {
          "200": { "description": "Danh sách các tập, nhãn VIP, thời lượng" }
        }
      }
    },
    "/stories/{id}/favorite": {
      "post": {
        "tags": ["Stories"],
        "summary": "Thêm / Bỏ truyện khỏi Tủ Truyện Yêu Thích",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Trạng thái yêu thích mới (true/false)" }
        }
      },
      "get": {
        "tags": ["Stories"],
        "summary": "Kiểm tra xem truyện đã được yêu thích chưa",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Trả về is_favorite: true/false" }
        }
      }
    },
    "/chapters/{id}": {
      "get": {
        "tags": ["Chapters"],
        "summary": "Lấy chi tiết tập truyện & nội dung chữ nếu có",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Chi tiết chương và các file audio đa chất lượng" }
        }
      }
    },
    "/chapters/playback-speeds": {
      "get": {
        "tags": ["Chapters"],
        "summary": "Lấy danh sách các tốc độ phát audio được hỗ trợ (0.5x, 0.75x, 1.0x, 1.25x, 1.5x, 1.75x, 2.0x...)",
        "responses": {
          "200": { "description": "Danh sách các tốc độ phát, nhãn hiển thị và mô tả" }
        }
      }
    },
    "/chapters/{id}/stream": {
      "get": {
        "tags": ["Chapters"],
        "summary": "Lấy Stream URL có chữ ký HMAC bảo mật để phát audio",
        "description": "Tự động kiểm tra quyền VIP đối với các chương trả phí và tạo đường link Cloudflare R2 có chữ ký giới hạn thời gian kèm tốc độ phát mong muốn.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          { "name": "quality", "in": "query", "type": "string", "enum": ["64k", "128k", "320k"], "default": "128k" },
          { "name": "speed", "in": "query", "type": "number", "enum": [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0], "default": 1.0, "description": "Tốc độ phát audio (0.5x đến 2.0x)" }
        ],
        "responses": {
          "200": { "description": "Trả về signed_url có hiệu lực trong 2 giờ, playback_speed và available_speeds" },
          "403": { "description": "Yêu cầu tài khoản Hội Viên VIP để nghe chương này" }
        }
      }
    },
    "/chapters": {
      "post": {
        "tags": ["Chapters"],
        "summary": "Tạo tập truyện mới",
        "security": [{ "BearerAuth": [] }],
