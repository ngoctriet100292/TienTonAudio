# ==============================================
# TienTon Audio — Environment Configuration
# ==============================================
# Copy this file to app.env for local development
# or .env for Docker Compose.
# NEVER commit real credentials to git!

# ---- Server ----
SERVER_ADDRESS=0.0.0.0:8080
ENVIRONMENT=development

# ---- PostgreSQL ----
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Docker Compose postgres config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=tientonaudio
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Docker Compose redis config
REDIS_PORT=6379

# ---- JWT ----
# Must be at least 32 characters long!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-must-be-long
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_ACCESS_KEY_SECRET=your-r2-secret-access-key
R2_BUCKET_NAME=tientonaudio
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PRESIGN_DURATION=1h

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ---- Upload ----
MAX_UPLOAD_SIZE_MB=500
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp4,audio/ogg,audio/wav,audio/aac

# ---- Email / SMTP ----
# SMTP phải được cấu hình để gửi thư; lỗi gửi thư được trả rõ ràng. Không log token.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
# Gmail: use a 16-character App Password with 2-Step Verification enabled.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=your-account@gmail.com
APP_BASE_URL=http://localhost:3000

# Authenticated payment adapter must send payment_id, transaction_id, status and amount (VND).
PAYMENT_WEBHOOK_SECRET=

# Trust only the actual reverse-proxy network; empty means direct connections only.
TRUSTED_PROXY_CIDRS=

# ---- OAuth / Goth (server-side only) ----
# Public backend origin; callback: /api/v1/auth/oauth/{provider}/callback
OAUTH_PUBLIC_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple requires a public HTTPS domain even during testing (no localhost callback).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Absolute path to .p8 key; never commit the key.
APPLE_PRIVATE_KEY_FILE=

# Enable only after the trusted payment adapter is connected and verified.
PAYMENT_CHECKOUT_ENABLED=false
PAYMENT_BANK_CODE=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_ACCOUNT_NAME=
